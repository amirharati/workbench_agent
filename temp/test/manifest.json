{
    "manifest_version": 3,
    "name": "Instant Sidepanel Test",
    "version": "1.0",
    "permissions": ["sidePanel"],
    "background": {
      "service_worker": "background.js"
    },
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "action": {
      "default_title": "Open Panel"
    }
  }
  