{
  "manifest_version": 3,
  "name": "Homebase",
  "version": "1.0.0",
  "description": "Your browser home for bookmarks, tabs, and knowledge — with optional AI.",
  "permissions": [
    "sidePanel",
    "offscreen",
    "tabs",
    "activeTab",
    "scripting",
    "alarms",
    "storage",
    "unlimitedStorage",
    "bookmarks"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "Open Homebase"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
