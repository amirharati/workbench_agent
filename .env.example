# Copy to .env for CLI scripts (fetch-ai-eval, categorize).
# The extension uses Settings > AI (chrome.storage) — NOT this file. Keep both in sync.
OPENROUTER_API_KEY=sk-or-v1-...

# Chat/completions (fetch-ai-eval, enrichment extract)
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embeddings (Task 02 categorization CLI; Settings UI later)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Cheaper baseline for experiments: sentence-transformers/all-minilm-l6-v2
# Stronger alternative: intfloat/e5-large-v2
